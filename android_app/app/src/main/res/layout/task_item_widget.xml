<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#ffffff"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <!-- Priority Accent Bar -->
    <View
        android:id="@+id/itemPriorityBar"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:background="#e11d48"
        android:layout_marginEnd="10dp" />

    <!-- Task Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="#0f172a"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/itemTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:48 AM"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action 1: Trash / Restore Button -->
    <ImageButton
        android:id="@+id/itemActionButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete Task"
        android:tint="#94a3b8" />

    <!-- Action 2: Checkbox Button -->
    <ImageButton
        android:id="@+id/itemCheckButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/checkbox_off_background"
        android:contentDescription="Toggle Task"
        android:layout_marginStart="4dp" />

</LinearLayout>

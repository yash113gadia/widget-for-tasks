<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#f8fafc">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textColor="#0f172a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#64748b"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Header Widgets -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Progress Percent Badge -->
            <TextView
                android:id="@+id/widgetProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#e0e7ff"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="0%"
                android:textColor="#6366f1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Add Task Button (+) -->
            <ImageButton
                android:id="@+id/widgetAddBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#e0e7ff"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Add Task"
                android:tint="#6366f1" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Task List (ListView inside RemoteViews) -->
    <ListView
        android:id="@+id/widgetListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:nestedScrollingEnabled="true" />

    <!-- Empty View for ListView -->
    <TextView
        android:id="@+id/widgetEmptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No tasks found"
        android:textColor="#94a3b8"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Bottom Filter Tabs Navigation Bar (High Touch Targets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:padding="3dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textColor="#6366f1"
            android:background="#e0e7ff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabActive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Active"
            android:textColor="#64748b"
            android:background="#ffffff"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Done"
            android:textColor="#64748b"
            android:background="#ffffff"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabTrash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Trash"
            android:textColor="#64748b"
            android:background="#ffffff"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

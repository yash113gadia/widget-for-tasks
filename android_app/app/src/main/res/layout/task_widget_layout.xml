<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="#f8fafc">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textColor="#0f172a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#64748b"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Header Widgets -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Progress Percent Badge -->
            <TextView
                android:id="@+id/widgetProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#e0e7ff"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="0%"
                android:textColor="#6366f1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/widgetRefreshBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#e0e7ff"
                android:src="@android:drawable/stat_notify_sync"
                android:contentDescription="Refresh Widget"
                android:tint="#6366f1"
                android:layout_marginEnd="6dp" />

            <!-- Add Task Button (+) -->
            <ImageButton
                android:id="@+id/widgetAddBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#e0e7ff"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Add Task"
                android:tint="#6366f1" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Task List (ListView filling remaining space below header) -->
    <ListView
        android:id="@+id/widgetListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:divider="@null"
        android:dividerHeight="4dp" />

    <!-- Empty View for ListView -->
    <TextView
        android:id="@+id/widgetEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:gravity="center"
        android:text="No tasks found"
        android:textColor="#94a3b8"
        android:textSize="13sp"
        android:visibility="gone" />

</RelativeLayout>

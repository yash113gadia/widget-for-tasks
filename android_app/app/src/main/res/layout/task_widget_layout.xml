<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#f8fafc">

    <!-- Widget Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:marginEnd="4dp"
        android:marginBottom="8dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tasks"
            android:textColor="#0f172a"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Synced"
            android:textColor="#6366f1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Task List Container -->
    <TextView
        android:id="@+id/widgetTaskListText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Loading tasks..."
        android:textColor="#64748b"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

    <!-- Refresh Button -->
    <Button
        android:id="@+id/widgetRefreshBtn"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Refresh Sync"
        android:textColor="#ffffff"
        android:backgroundTint="#6366f1"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
